# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
ENV/
env/

# Model checkpoints (large files)
checkpoints/
*.pt
*.pth
*.onnx
*.safetensors

# Data
data/
*.npy
*.npz

# EXCEPTION — T2.14's derived CMU corpus (5.7 MB). experiments/gpu.py ships work
# to a GPU VM by cloning this repo, and that clone is the only channel: the VM
# cannot see /data/jack-data. So a GPU spec whose claim is about real recorded
# motion can only run if its corpus travels in the repo, pinned to the same
# commit as the code that reads it. Regenerate with scripts/build_t214_corpus.py;
# the spec re-checks the sha256 before spending a GPU hour. Do not extend this
# exception to a new blob without the same justification.
!experiments/data/
!experiments/data/t214_cmu_corpus.npz

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Jupyter checkpoints
.ipynb_checkpoints/

# Experiment artifacts (the ledger itself IS tracked — it is the capability record)
experiments/artifacts/
experiments/**/__pycache__/
.usage-resumed

# Ephemeral probe scripts written by an iteration mid-investigation.
# They live on disk for the run that made them and must not enter history:
# a scratch file committed by ANOTHER process reads as a deliverable later.
scratch_*.py
MUJOCO_LOG.TXT
# CPU budget accountant's lock/tmp debris (the record itself IS tracked,
# like gpu_budget.json).
experiments/cpu_budget.json.lock
experiments/cpu_budget.json.tmp
