<!--
JACK'S ROOM - Virtual Companion Environment

A simple furnished room for Jack the humanoid companion to live in.
Contains interactive objects and furniture for autonomous exploration.

Compatible with Gymnasium Humanoid-v5 (21 actuators).
Rendering-optimized with good lighting and camera placement.

Author: Janno Louwrens
-->
<mujoco model="jack_room">

  <!-- ======================================================== -->
  <!-- COMPILER & SIMULATION OPTIONS                            -->
  <!-- ======================================================== -->
  <compiler angle="radian" inertiafromgeom="true"/>

  <option integrator="RK4" iterations="50" solver="PGS" timestep="0.002">
    <flag warmstart="enable"/>
  </option>

  <size nkey="5" nuser_geom="1"/>

  <!-- ======================================================== -->
  <!-- DEFAULTS                                                 -->
  <!-- ======================================================== -->
  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom conaffinity="1" condim="3" friction="1 0.5 0.5" margin="0.001"
          material="geom" rgba="0.8 0.6 0.4 1"/>
    <motor ctrllimited="true" ctrlrange="-0.4 0.4"/>
  </default>

  <!-- ======================================================== -->
  <!-- VISUAL SETTINGS (shadows, reflections, warm tones)       -->
  <!-- ======================================================== -->
  <visual>
    <map fogend="10" fogstart="6" znear="0.01"/>
    <quality shadowsize="4096" offsamples="8"/>
    <global offwidth="1280" offheight="720"/>
    <rgba haze="0.35 0.3 0.25 1"/>
  </visual>

  <!-- ======================================================== -->
  <!-- ASSETS (textures & materials)                            -->
  <!-- ======================================================== -->
  <asset>
    <!-- Sky -->
    <texture builtin="gradient" height="256" rgb1="0.6 0.7 0.9"
             rgb2="0.15 0.15 0.3" type="skybox" width="256"/>

    <!-- Humanoid skin texture -->
    <texture builtin="flat" height="1024" mark="cross" markrgb="1 1 1"
             name="texgeom" random="0.01" rgb1="0.8 0.6 0.4"
             rgb2="0.8 0.6 0.4" type="cube" width="127"/>

    <!-- Floor - warm wood-like checker -->
    <texture builtin="checker" height="256" name="texfloor"
             rgb1="0.55 0.35 0.2" rgb2="0.45 0.28 0.15"
             type="2d" width="256"/>

    <!-- Wall texture -->
    <texture builtin="flat" height="256" name="texwall"
             rgb1="0.92 0.9 0.85" rgb2="0.88 0.86 0.8"
             type="2d" width="256"/>

    <!-- Furniture texture -->
    <texture builtin="flat" height="128" name="texwood"
             rgb1="0.55 0.35 0.18" rgb2="0.5 0.3 0.15"
             type="2d" width="128"/>

    <!-- Materials -->
    <material name="geom" texture="texgeom" texuniform="true"/>
    <material name="floor_mat" texture="texfloor" texrepeat="8 8"
              reflectance="0.15" shininess="0.3" specular="0.3"/>
    <material name="wall_mat" texture="texwall" texrepeat="4 4"
              reflectance="0.05" shininess="0.1" specular="0.1"
              rgba="0.92 0.9 0.85 0.35"/>
    <material name="wood_mat" texture="texwood" texrepeat="2 2"
              reflectance="0.1" shininess="0.4" specular="0.3"/>
    <material name="metal_mat" rgba="0.5 0.5 0.55 1"
              reflectance="0.3" shininess="0.8" specular="0.7"/>
    <material name="cup_mat" rgba="0.95 0.95 0.98 1"
              reflectance="0.1" shininess="0.5" specular="0.4"/>
    <material name="ball_mat" rgba="0.85 0.2 0.15 1"
              reflectance="0.05" shininess="0.3" specular="0.2"/>
    <material name="book_mat" rgba="0.15 0.3 0.55 1"
              reflectance="0.05" shininess="0.2" specular="0.1"/>
    <material name="shelf_mat" rgba="0.6 0.38 0.2 1"
              reflectance="0.1" shininess="0.3" specular="0.2"/>
  </asset>

  <!-- ======================================================== -->
  <!-- WORLDBODY                                                -->
  <!-- ======================================================== -->
  <worldbody>

    <!-- ==================== LIGHTING ======================== -->
    <!-- Main overhead light (warm white) -->
    <light name="overhead" directional="true" pos="0 0 4"
           dir="0 0 -1" diffuse="1.0 0.95 0.85" specular="0.3 0.28 0.25"
           ambient="0.15 0.13 0.1" cutoff="100" exponent="1"/>

    <!-- Fill light from the side (softer, warm) -->
    <light name="fill_left" pos="-2 2 2.5" dir="1 -1 -0.5"
           diffuse="0.4 0.35 0.25" specular="0.1 0.08 0.06"
           cutoff="60" exponent="5"/>

    <!-- Accent light from the opposite side -->
    <light name="fill_right" pos="2 -2 2.5" dir="-1 1 -0.5"
           diffuse="0.3 0.28 0.2" specular="0.08 0.06 0.04"
           cutoff="60" exponent="5"/>

    <!-- ==================== CAMERAS ========================= -->
    <!-- Default room view: standing back in a corner looking in -->
    <camera name="room_view" pos="3.5 -3.5 2.5" xyaxes="0.7 0.7 0 -0.2 0.2 0.95"
            fovy="60"/>

    <!-- Overhead bird's-eye view -->
    <camera name="overhead_view" pos="0 0 5.5" xyaxes="1 0 0 0 1 0"
            fovy="70"/>

    <!-- Close-up face view (for observing the humanoid) -->
    <camera name="face_view" pos="0.6 -0.8 1.6" xyaxes="0.8 0.6 0 -0.15 0.2 0.97"
            fovy="40"/>

    <!-- ==================== FLOOR ============================ -->
    <!-- Room floor (4m x 4m wooden floor) -->
    <geom name="floor" type="plane" size="2 2 0.05" pos="0 0 0"
          material="floor_mat" conaffinity="1" condim="3"
          friction="1 0.5 0.5"/>

    <!-- ==================== WALLS ============================ -->
    <!-- Walls are semi-transparent so the camera can see through them.
         They provide visual boundaries but don't block the view. -->

    <!-- North wall (y = +2) -->
    <geom name="wall_north" type="box" size="2 0.05 1.4" pos="0 2 1.4"
          material="wall_mat" conaffinity="0" contype="0"/>

    <!-- South wall (y = -2) -->
    <geom name="wall_south" type="box" size="2 0.05 1.4" pos="0 -2 1.4"
          material="wall_mat" conaffinity="0" contype="0"/>

    <!-- East wall (x = +2) -->
    <geom name="wall_east" type="box" size="0.05 2 1.4" pos="2 0 1.4"
          material="wall_mat" conaffinity="0" contype="0"/>

    <!-- West wall (x = -2) -->
    <geom name="wall_west" type="box" size="0.05 2 1.4" pos="-2 0 1.4"
          material="wall_mat" conaffinity="0" contype="0"/>

    <!-- ====================================================== -->
    <!-- FURNITURE                                              -->
    <!-- ====================================================== -->

    <!-- ==================== TABLE ============================ -->
    <!-- A simple wooden table: tabletop + 4 legs.
         Positioned at x=1.2 y=0, height 0.72m (standard desk height). -->
    <body name="table" pos="1.2 0 0">
      <!-- Tabletop -->
      <geom name="table_top" type="box" size="0.4 0.3 0.02"
            pos="0 0 0.72" material="wood_mat" mass="8"/>
      <!-- Legs -->
      <geom name="table_leg_1" type="cylinder" size="0.025 0.35"
            pos="0.35 0.25 0.35" material="wood_mat"/>
      <geom name="table_leg_2" type="cylinder" size="0.025 0.35"
            pos="0.35 -0.25 0.35" material="wood_mat"/>
      <geom name="table_leg_3" type="cylinder" size="0.025 0.35"
            pos="-0.35 0.25 0.35" material="wood_mat"/>
      <geom name="table_leg_4" type="cylinder" size="0.025 0.35"
            pos="-0.35 -0.25 0.35" material="wood_mat"/>
    </body>

    <!-- ==================== CHAIR ============================ -->
    <!-- A simple chair: seat + backrest + 4 legs.
         Positioned near the table, facing it. Seat height ~0.45m. -->
    <body name="chair" pos="0.5 0 0">
      <!-- Seat -->
      <geom name="chair_seat" type="box" size="0.2 0.2 0.015"
            pos="0 0 0.45" material="wood_mat" mass="4"/>
      <!-- Backrest -->
      <geom name="chair_back" type="box" size="0.02 0.18 0.2"
            pos="-0.18 0 0.65" material="wood_mat"/>
      <!-- Legs -->
      <geom name="chair_leg_1" type="cylinder" size="0.02 0.225"
            pos="0.16 0.16 0.225" material="wood_mat"/>
      <geom name="chair_leg_2" type="cylinder" size="0.02 0.225"
            pos="0.16 -0.16 0.225" material="wood_mat"/>
      <geom name="chair_leg_3" type="cylinder" size="0.02 0.225"
            pos="-0.16 0.16 0.225" material="wood_mat"/>
      <geom name="chair_leg_4" type="cylinder" size="0.02 0.225"
            pos="-0.16 -0.16 0.225" material="wood_mat"/>
    </body>

    <!-- ==================== SHELF ============================ -->
    <!-- Wall-mounted shelf with 2 tiers.
         Against the north wall at y=1.7, two shelf planks. -->
    <body name="shelf" pos="-1.0 1.7 0">
      <!-- Shelf support (back panel) -->
      <geom name="shelf_back" type="box" size="0.4 0.02 0.5"
            pos="0 0 1.1" material="shelf_mat" mass="3"/>
      <!-- Lower shelf plank (height ~0.9m) -->
      <geom name="shelf_lower" type="box" size="0.4 0.15 0.012"
            pos="0 -0.1 0.9" material="shelf_mat" mass="1.5"/>
      <!-- Upper shelf plank (height ~1.3m) -->
      <geom name="shelf_upper" type="box" size="0.4 0.15 0.012"
            pos="0 -0.1 1.3" material="shelf_mat" mass="1.5"/>
    </body>

    <!-- ====================================================== -->
    <!-- INTERACTIVE OBJECTS (free joints - can be moved)       -->
    <!-- ====================================================== -->

    <!-- ==================== CUP ============================== -->
    <!-- A ceramic cup on the table. Mass: 0.2 kg.
         Small cylinder, can be picked up and moved. -->
    <body name="cup" pos="1.3 0.1 0.79">
      <freejoint name="cup_joint"/>
      <geom name="cup_body" type="cylinder" size="0.035 0.045"
            material="cup_mat" mass="0.2"/>
      <site name="cup_grasp" pos="0 0 0.02" size="0.008"
            rgba="0 1 0 0"/>
    </body>

    <!-- ==================== BALL ============================== -->
    <!-- A red rubber ball on the floor. Mass: 0.1 kg.
         Can be pushed, kicked, or picked up. -->
    <body name="ball" pos="-0.5 -0.8 0.06">
      <freejoint name="ball_joint"/>
      <geom name="ball_body" type="sphere" size="0.06"
            material="ball_mat" mass="0.1"/>
    </body>

    <!-- ==================== BOOK ============================== -->
    <!-- A book resting on the lower shelf. Mass: 0.5 kg.
         Flat box shape, can be picked up. -->
    <body name="book" pos="-1.0 1.55 0.94">
      <freejoint name="book_joint"/>
      <geom name="book_body" type="box" size="0.1 0.07 0.015"
            material="book_mat" mass="0.5"/>
    </body>

    <!-- ====================================================== -->
    <!-- HUMANOID (Gymnasium Humanoid-v5, 21 actuators)         -->
    <!--                                                        -->
    <!-- Standard MuJoCo humanoid body structure.               -->
    <!-- Spawns in the center of the room, standing upright.    -->
    <!-- Joint ranges are in radians (compiler angle=radian).   -->
    <!-- ====================================================== -->
    <body name="torso" pos="0 0 1.4">
      <!-- Tracking camera attached to torso -->
      <camera name="track" mode="trackcom" pos="0 -3 0.3"
              xyaxes="1 0 0 0 0 1"/>

      <!-- Free joint: 6-DOF root (translation + rotation) -->
      <joint armature="0" damping="0" limited="false" name="root"
             pos="0 0 0" stiffness="0" type="free"/>

      <!-- Torso geometry -->
      <geom fromto="0 -0.07 0 0 0.07 0" name="torso1"
            size="0.07" type="capsule"/>
      <geom name="head" pos="0 0 0.19" size="0.09" type="sphere"/>
      <!-- Jack's eyes: first-person cameras on the head -->
      <!-- These are what Jack "sees" - rendered for the vision encoder -->
      <camera name="eye_left" pos="-0.03 0.08 0.19" xyaxes="1 0 0 0 0.3 0.95"
              fovy="60"/>
      <camera name="eye_right" pos="0.03 0.08 0.19" xyaxes="1 0 0 0 0.3 0.95"
              fovy="60"/>
      <!-- Single combined eye (simpler, used by default) -->
      <camera name="eye" pos="0 0.09 0.19" xyaxes="1 0 0 0 0.3 0.95"
              fovy="70"/>
      <geom fromto="-0.01 -0.06 -0.12 -0.01 0.06 -0.12" name="uwaist"
            size="0.06" type="capsule"/>

      <!-- ============ LOWER TORSO ============ -->
      <body name="lwaist" pos="-0.01 0 -0.16">
        <geom fromto="0 -0.06 0 0 0.06 0" name="lwaist"
              size="0.06" type="capsule"/>
        <joint armature="0.02" axis="0 0 1" damping="5" name="abdomen_z"
               pos="0 0 0.065" range="-0.7854 0.7854"
               stiffness="20" type="hinge"/>
        <joint armature="0.02" axis="0 1 0" damping="5" name="abdomen_y"
               pos="0 0 0.065" range="-1.3090 0.5236"
               stiffness="10" type="hinge"/>

        <!-- ============ PELVIS ============ -->
        <body name="pelvis" pos="0 0 -0.165">
          <joint armature="0.02" axis="1 0 0" damping="5" name="abdomen_x"
                 pos="0 0 0.1" range="-0.6109 0.6109"
                 stiffness="10" type="hinge"/>
          <geom fromto="-0.02 -0.07 0 -0.02 0.07 0" name="butt"
                size="0.09" type="capsule"/>

          <!-- ============ RIGHT LEG ============ -->
          <body name="right_thigh" pos="0 -0.1 -0.04">
            <joint armature="0.01" axis="1 0 0" damping="5"
                   name="right_hip_x" pos="0 0 0"
                   range="-0.4363 0.0873" stiffness="10" type="hinge"/>
            <joint armature="0.01" axis="0 0 1" damping="5"
                   name="right_hip_z" pos="0 0 0"
                   range="-1.0472 0.6109" stiffness="10" type="hinge"/>
            <joint armature="0.01" axis="0 1 0" damping="5"
                   name="right_hip_y" pos="0 0 0"
                   range="-2.0944 0.3491" stiffness="20" type="hinge"/>
            <geom fromto="0 0 0 0 0.01 -0.34" name="right_thigh1"
                  size="0.06" type="capsule"/>

            <body name="right_shin" pos="0 0.01 -0.403">
              <joint armature="0.006" axis="0 -1 0" damping="6"
                     name="right_knee" pos="0 0 0.02"
                     range="-2.7925 -0.0349" stiffness="15" type="hinge"/>
              <geom fromto="0 0 0 0 0 -0.3" name="right_shin1"
                    size="0.049" type="capsule"/>

              <body name="right_foot" pos="0 0 -0.39">
                <joint armature="0.004" axis="0 1 0" damping="3"
                       name="right_ankle_y" pos="0 0 0.08"
                       range="-0.8727 0.8727" stiffness="4" type="hinge"/>
                <joint armature="0.004" axis="1 0 0.5" damping="1"
                       name="right_ankle_x" pos="0 0 0.04"
                       range="-0.8727 0.8727" stiffness="1" type="hinge"/>
                <geom name="right_foot" pos="0 0 0"
                      size="0.075 0.04 0.03" type="box"/>
              </body>
            </body>
          </body>

          <!-- ============ LEFT LEG ============ -->
          <body name="left_thigh" pos="0 0.1 -0.04">
            <joint armature="0.01" axis="-1 0 0" damping="5"
                   name="left_hip_x" pos="0 0 0"
                   range="-0.4363 0.0873" stiffness="10" type="hinge"/>
            <joint armature="0.01" axis="0 0 -1" damping="5"
                   name="left_hip_z" pos="0 0 0"
                   range="-1.0472 0.6109" stiffness="10" type="hinge"/>
            <joint armature="0.01" axis="0 1 0" damping="5"
                   name="left_hip_y" pos="0 0 0"
                   range="-2.0944 0.3491" stiffness="20" type="hinge"/>
            <geom fromto="0 0 0 0 -0.01 -0.34" name="left_thigh1"
                  size="0.06" type="capsule"/>

            <body name="left_shin" pos="0 -0.01 -0.403">
              <joint armature="0.006" axis="0 -1 0" damping="6"
                     name="left_knee" pos="0 0 0.02"
                     range="-2.7925 -0.0349" stiffness="15" type="hinge"/>
              <geom fromto="0 0 0 0 0 -0.3" name="left_shin1"
                    size="0.049" type="capsule"/>

              <body name="left_foot" pos="0 0 -0.39">
                <joint armature="0.004" axis="0 1 0" damping="3"
                       name="left_ankle_y" pos="0 0 0.08"
                       range="-0.8727 0.8727" stiffness="4" type="hinge"/>
                <joint armature="0.004" axis="1 0 0.5" damping="1"
                       name="left_ankle_x" pos="0 0 0.04"
                       range="-0.8727 0.8727" stiffness="1" type="hinge"/>
                <geom name="left_foot" pos="0 0 0"
                      size="0.075 0.04 0.03" type="box"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ============ RIGHT ARM ============ -->
      <body name="right_upper_arm" pos="0 -0.17 0.06">
        <joint armature="0.004" axis="2 1 1" damping="1"
               name="right_shoulder1" pos="0 0 0"
               range="-1.4835 1.0472" stiffness="1" type="hinge"/>
        <joint armature="0.004" axis="0 -1 1" damping="1"
               name="right_shoulder2" pos="0 0 0"
               range="-1.4835 1.0472" stiffness="1" type="hinge"/>
        <geom fromto="0 0 0 0.16 -0.16 -0.16" name="right_uarm1"
              size="0.04" type="capsule"/>

        <body name="right_lower_arm" pos="0.18 -0.18 -0.18">
          <joint armature="0.004" axis="0 -1 1" damping="0.5"
                 name="right_elbow" pos="0 0 0"
                 range="-1.5708 0.8727" stiffness="0.5" type="hinge"/>
          <geom fromto="0.01 0.01 0.01 0.17 0.17 0.17" name="right_larm"
                size="0.031" type="capsule"/>
          <geom name="right_hand" pos="0.18 0.18 0.18"
                size="0.04" type="sphere"/>
        </body>
      </body>

      <!-- ============ LEFT ARM ============ -->
      <body name="left_upper_arm" pos="0 0.17 0.06">
        <joint armature="0.004" axis="2 -1 1" damping="1"
               name="left_shoulder1" pos="0 0 0"
               range="-1.0472 1.4835" stiffness="1" type="hinge"/>
        <joint armature="0.004" axis="0 1 1" damping="1"
               name="left_shoulder2" pos="0 0 0"
               range="-1.0472 1.4835" stiffness="1" type="hinge"/>
        <geom fromto="0 0 0 0.16 0.16 -0.16" name="left_uarm1"
              size="0.04" type="capsule"/>

        <body name="left_lower_arm" pos="0.18 0.18 -0.18">
          <joint armature="0.004" axis="0 -1 -1" damping="0.5"
                 name="left_elbow" pos="0 0 0"
                 range="-1.5708 0.8727" stiffness="0.5" type="hinge"/>
          <geom fromto="0.01 -0.01 0.01 0.17 -0.17 0.17" name="left_larm"
                size="0.031" type="capsule"/>
          <geom name="left_hand" pos="0.18 -0.18 0.18"
                size="0.04" type="sphere"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ======================================================== -->
  <!-- ACTUATORS (21 motors - Humanoid-v5 compatible)           -->
  <!--                                                          -->
  <!-- Order matches the standard MuJoCo Humanoid body:         -->
  <!--   0-2:   abdomen  (y, z, x)                             -->
  <!--   3-8:   right leg (hip_x, hip_z, hip_y, knee,          -->
  <!--          ankle_x, ankle_y)                               -->
  <!--   9-14:  left leg  (hip_x, hip_z, hip_y, knee,          -->
  <!--          ankle_x, ankle_y)                               -->
  <!--   15-17: right arm (shoulder1, shoulder2, elbow)         -->
  <!--   18-20: left arm  (shoulder1, shoulder2, elbow)         -->
  <!-- ======================================================== -->
  <actuator>
    <!-- Abdomen (3 actuators) -->
    <motor gear="100" joint="abdomen_y"  name="abdomen_y"/>
    <motor gear="100" joint="abdomen_z"  name="abdomen_z"/>
    <motor gear="100" joint="abdomen_x"  name="abdomen_x"/>

    <!-- Right leg (6 actuators) -->
    <motor gear="100" joint="right_hip_x"    name="right_hip_x"/>
    <motor gear="100" joint="right_hip_z"    name="right_hip_z"/>
    <motor gear="300" joint="right_hip_y"    name="right_hip_y"/>
    <motor gear="200" joint="right_knee"     name="right_knee"/>
    <motor gear="100" joint="right_ankle_x"  name="right_ankle_x"/>
    <motor gear="100" joint="right_ankle_y"  name="right_ankle_y"/>

    <!-- Left leg (6 actuators) -->
    <motor gear="100" joint="left_hip_x"    name="left_hip_x"/>
    <motor gear="100" joint="left_hip_z"    name="left_hip_z"/>
    <motor gear="300" joint="left_hip_y"    name="left_hip_y"/>
    <motor gear="200" joint="left_knee"     name="left_knee"/>
    <motor gear="100" joint="left_ankle_x"  name="left_ankle_x"/>
    <motor gear="100" joint="left_ankle_y"  name="left_ankle_y"/>

    <!-- Right arm (3 actuators) -->
    <motor gear="25"  joint="right_shoulder1" name="right_shoulder1"/>
    <motor gear="25"  joint="right_shoulder2" name="right_shoulder2"/>
    <motor gear="25"  joint="right_elbow"     name="right_elbow"/>

    <!-- Left arm (3 actuators) -->
    <motor gear="25"  joint="left_shoulder1"  name="left_shoulder1"/>
    <motor gear="25"  joint="left_shoulder2"  name="left_shoulder2"/>
    <motor gear="25"  joint="left_elbow"      name="left_elbow"/>
  </actuator>

</mujoco>
