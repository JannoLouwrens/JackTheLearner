<!--
MANIPULATION SCENE
==================

Objects for the robot to interact with:
- Table with cup, bottle, bowl
- Kitchen counter (for "make coffee" scenario)
- Various graspable objects

Include this in humanoid_full.xml or load separately.

Author: Janno Louwrens
-->
<mujoco model="manipulation_scene">
  <include file="humanoid_full.xml"/>

  <asset>
    <material name="table_mat" rgba="0.6 0.4 0.2 1"/>
    <material name="cup_mat" rgba="0.9 0.9 0.95 1"/>
    <material name="bottle_mat" rgba="0.2 0.5 0.2 0.7"/>
    <material name="bowl_mat" rgba="0.8 0.3 0.3 1"/>
    <material name="counter_mat" rgba="0.7 0.7 0.7 1"/>
  </asset>

  <worldbody>
    <!-- ===== TABLE ===== -->
    <body name="table" pos="1.5 0 0">
      <geom name="table_top" type="box" size="0.4 0.3 0.02" pos="0 0 0.7" material="table_mat" mass="10"/>
      <geom name="table_leg1" type="cylinder" size="0.03 0.35" pos="0.35 0.25 0.35" material="table_mat"/>
      <geom name="table_leg2" type="cylinder" size="0.03 0.35" pos="0.35 -0.25 0.35" material="table_mat"/>
      <geom name="table_leg3" type="cylinder" size="0.03 0.35" pos="-0.35 0.25 0.35" material="table_mat"/>
      <geom name="table_leg4" type="cylinder" size="0.03 0.35" pos="-0.35 -0.25 0.35" material="table_mat"/>
    </body>

    <!-- ===== CUP (graspable) ===== -->
    <body name="cup" pos="1.5 0.1 0.78">
      <freejoint name="cup_joint"/>
      <geom name="cup_body" type="cylinder" size="0.035 0.05" material="cup_mat" mass="0.1"/>
      <site name="cup_grasp" pos="0 0 0.025" size="0.01"/>
    </body>

    <!-- ===== BOTTLE (graspable) ===== -->
    <body name="bottle" pos="1.5 -0.15 0.82">
      <freejoint name="bottle_joint"/>
      <geom name="bottle_body" type="cylinder" size="0.03 0.1" material="bottle_mat" mass="0.3"/>
      <geom name="bottle_neck" type="cylinder" size="0.015 0.03" pos="0 0 0.12" material="bottle_mat"/>
      <site name="bottle_grasp" pos="0 0 0.05" size="0.01"/>
    </body>

    <!-- ===== BOWL (graspable) ===== -->
    <body name="bowl" pos="1.3 0 0.74">
      <freejoint name="bowl_joint"/>
      <geom name="bowl_outer" type="cylinder" size="0.06 0.03" material="bowl_mat" mass="0.15"/>
      <site name="bowl_grasp" pos="0 0 0.015" size="0.01"/>
    </body>

    <!-- ===== KITCHEN COUNTER (static, for coffee scenario) ===== -->
    <body name="counter" pos="3 0 0">
      <geom name="counter_top" type="box" size="0.5 0.8 0.03" pos="0 0 0.9" material="counter_mat"/>
      <geom name="counter_body" type="box" size="0.48 0.78 0.45" pos="0 0 0.45" material="counter_mat" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- ===== COFFEE MACHINE (static, target object) ===== -->
    <body name="coffee_machine" pos="3 0.3 0.95">
      <geom name="coffee_base" type="box" size="0.1 0.08 0.1" material="counter_mat" rgba="0.2 0.2 0.2 1"/>
      <geom name="coffee_top" type="box" size="0.08 0.06 0.12" pos="0 0 0.2" rgba="0.2 0.2 0.2 1"/>
      <site name="coffee_button" pos="0.08 0 0.15" size="0.015" rgba="1 0 0 1"/>
      <site name="coffee_cup_spot" pos="0 0 -0.08" size="0.04" rgba="0 1 0 0.3"/>
    </body>

    <!-- ===== TARGET MARKERS (for navigation training) ===== -->
    <site name="nav_target_1" pos="2 1 0.01" size="0.1" rgba="0 1 0 0.5"/>
    <site name="nav_target_2" pos="2 -1 0.01" size="0.1" rgba="0 0 1 0.5"/>
    <site name="kitchen_target" pos="3 0 0.01" size="0.2" rgba="1 1 0 0.5"/>
  </worldbody>
</mujoco>
